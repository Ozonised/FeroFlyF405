	)
	(text "Crystal load capacitor formula:\n-> Cl - Cs = (Cl1 * Cl2)/(Cl1 + Cl2)\n-> Cl : Load capacitance defined by manufacturer\n(here 18pF)\n\n-> Cs : Stray capacitance\nCs = (PH pin capacitance +  PCB stray capacitance)\nPH pin capacitance = 5pF (from datasheet) & \nPCB stray capacitance = 4pF approx\n\n-> Cl1 and Cl2 have the same value"
		(exclude_from_sim no)
		(at 84.582 108.458 0)
		(effects
			(font
				(size 0.6604 0.6604)
			)
			(justify left)
		)
		(uuid "67e5fcc9-b5ba-42d5-a6a6-eac264f9af8a")
	)
	(text "(3) MCU"
